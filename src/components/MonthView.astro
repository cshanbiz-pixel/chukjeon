---
import FestivalCard from './FestivalCard.astro';
import { festivalsInMonth, buildDate } from '../lib/festivals';
import { siteConfig } from '../lib/site-config';
interface Props { month: string }
const { month } = Astro.props;
const list = festivalsInMonth(month);
const date = new Date(`${buildDate}T00:00:00Z`);
const saturday = new Date(date);
const day = date.getUTCDay();
saturday.setUTCDate(date.getUTCDate() + (day === 0 ? -1 : 6 - day));
const sunday = new Date(saturday);
sunday.setUTCDate(saturday.getUTCDate() + 1);
const weekendStart = saturday.toISOString().slice(0, 10);
const weekendEnd = sunday.toISOString().slice(0, 10);
const ongoing = list.filter(f => f.startDate <= buildDate && f.endDate >= buildDate).length;
const weekend = list.filter(f => f.startDate <= weekendEnd && f.endDate >= weekendStart).length;
const statuses = [['all', '전체'], ['ongoing', '진행중'], ['weekend', '이번 주말'], ['soon', '곧 시작'], ['ending', '곧 끝남']];
const tags = ['전체', '무료', '야간', '가족', '자연', '음악', '마켓'];
const monthEnglish = new Intl.DateTimeFormat('en', { month: 'long', timeZone: 'UTC' }).format(new Date(`${month}-01T00:00:00Z`)).toUpperCase();
---
<header class="header" id="home-header">
  <a href="/" class="brand" aria-label="축제ON 홈"><img src="/images/logo.png" width="142" height="47" alt="축제ON ChukjeON" /></a>
  <span class="header-month">{month.replace('-', '. ')}</span>
  <!-- 3단계에서 구현: 검색 열기. 현재는 모양만 표시합니다. -->
  <button type="button" class="icon-button" aria-label="축제 검색 (3단계에서 구현)" aria-disabled="true"><svg aria-hidden="true"><use href="#i-search" /></svg></button>
</header>
<main id="main">
  <section id="home-view">
    <section class="intro">
      <div class="intro-top"><span class="eyebrow"><i></i>{monthEnglish}, {month.slice(0, 4)}</span>{siteConfig.sampleMode && <span class="sample-label">가상 데이터 시안</span>}</div>
      <h1>가을의 끝에서,<br />축제를 만나요<span class="title-dot">.</span></h1>
      <p>멀리 가지 않아도, 특별한 하루가 기다려요.</p>
      <div class="intro-flower" aria-hidden="true">✳</div>
    </section>
    <!-- 3단계에서 구현: 요약 바 상태 필터. 현재 클릭해도 아무 동작이 없습니다. -->
    <nav class="summary" aria-label="축제 요약">
      <button type="button" aria-disabled="true"><span class="live-dot"></span>진행중 <b id="ongoing-count">{ongoing}</b></button><span class="summary-divider"></span>
      <button type="button" aria-disabled="true">이번 주말 <b id="weekend-count">{weekend}</b></button><span class="summary-divider"></span>
      <button type="button" aria-disabled="true">이번 달 <b>{list.length}</b></button>
    </nav>
    <section class="filters" aria-label="축제 필터">
      <!-- 3단계에서 구현: 단일 상태 선택, 복수 해시태그 AND 필터, URL 동기화. -->
      <div class="chip-row status-chips" role="group" aria-label="상태 선택">
        {statuses.map(([key, label]) => <button type="button" class:list={['chip', { selected: key === 'all' }]} data-status={key} aria-pressed={key === 'all'} aria-disabled="true">{label}</button>)}
      </div>
      <div class="chip-row tag-chips" role="group" aria-label="해시태그 선택">
        {tags.map(tag => <button type="button" class:list={['tag-chip', { selected: tag === '전체' }]} data-tag={tag === '전체' ? 'all' : tag} aria-pressed={tag === '전체'} aria-disabled="true">#{tag}</button>)}
      </div>
    </section>
    <section class="list-section" aria-labelledby="list-title">
      <div class="section-heading"><h2 id="list-title">이번 달, 이런 축제 어때요? <span>{list.length}</span></h2><span>시작일순</span></div>
      {list.length > 0 ? <div class="festival-grid">{list.map((festival, i) => <>
        <FestivalCard festival={festival} featured={i === 0} eager={i === 0} />
        {(i + 1) % 6 === 0 && <div class="ad-slot" aria-label="광고 예정 공간"><span>ADVERTISEMENT</span><p>광고가 들어갈 공간이에요</p></div>}
      </>)}</div> : <div class="empty-state"><span aria-hidden="true">✳</span><h3>아직 등록된 축제가 없어요</h3><p>{siteConfig.sampleMode ? '가상 축제 10개는 2026년 11월에 모아두었어요.' : '다른 월의 축제 일정을 확인해 보세요.'}</p>{siteConfig.sampleMode && <a class="primary-button" href="/2026/11/">11월 샘플 보기</a>}</div>}
    </section>
    <aside class="closing-note"><svg aria-hidden="true"><use href="#i-spark" /></svg><div><strong>일상에 즐거움을 켜는 순간</strong><p>이번 주말은 축제ON과 함께해요.</p></div></aside>
    <footer class="footer"><span class="footer-wordmark">축제<span>ON</span></span><p>전국의 즐거운 순간을 모으다.</p>{siteConfig.sampleMode && <div class="disclaimer">샘플 데이터 · 디자인 확인용 · 실제 행사 정보가 아닙니다.<br />사진은 분위기 참고 이미지이며 실제 행사 사진이 아닙니다.</div>}</footer>
  </section>
</main>
<script>
  // 1단계의 현재 날짜 상태 표시만 유지합니다. 필터 클릭은 3단계에서 구현.
  import { seoulToday, festivalStatus } from '../lib/dates';
  function updateStatuses() {
    const today = seoulToday();
    const date = new Date(`${today}T00:00:00Z`);
    const day = date.getUTCDay();
    const saturday = new Date(date);
    saturday.setUTCDate(date.getUTCDate() + (day === 0 ? -1 : 6 - day));
    const sunday = new Date(saturday);
    sunday.setUTCDate(saturday.getUTCDate() + 1);
    const from = saturday.toISOString().slice(0, 10);
    const until = sunday.toISOString().slice(0, 10);
    let ongoing = 0;
    let weekend = 0;
    document.querySelectorAll<HTMLElement>('.badge[data-start][data-end]').forEach(badge => {
      const { start, end } = badge.dataset;
      if (!start || !end) return;
      badge.textContent = festivalStatus(start, end, today);
      badge.classList.toggle('ongoing', start <= today && end >= today);
      if (start <= today && end >= today) ongoing++;
      if (start <= until && end >= from) weekend++;
    });
    const ongoingLabel = document.getElementById('ongoing-count');
    const weekendLabel = document.getElementById('weekend-count');
    if (ongoingLabel) ongoingLabel.textContent = String(ongoing);
    if (weekendLabel) weekendLabel.textContent = String(weekend);
  }
  updateStatuses();
  document.addEventListener('visibilitychange', () => { if (!document.hidden) updateStatuses(); });
  window.setInterval(updateStatuses, 60_000);
</script>
